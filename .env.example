# Docker Compose env for the DrumDash dev web stack.
#
# Copy to `.env` and adjust. `.env` is gitignored; this example is the template.
#
# The Worker holds the upstream API key, so this file is a secret file. Keep it
# out of version control.

# Which API the Worker proxies to.
#   host.docker.internal:8001  -> the API running on this machine (dev chain)
#   https://api.northshorepress.co -> production
UPSTREAM_BASE=http://host.docker.internal:8001

# Credential the Worker attaches to upstream calls. The dev API accepts the
# legacy key; see docker-compose.yml in northshorepress-server.
UPSTREAM_API_KEY=replace-with-the-dev-api-key

# Any long random string. Only guards the local session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Origins allowed to call /api/*. Must include the URL you open in the browser,
# including the LAN IP when testing from a phone.
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# So files written by the Jekyll build container stay owned by you.
HOST_UID=1000
HOST_GID=1000
